{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "flai",
  "version": "1.0.0",
  "identifier": "com.jvoltci.flai",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "flai",
        "width": 980,
        "height": 680,
        "minWidth": 640,
        "minHeight": 420,
        "backgroundColor": "#101014"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "A torrent downloader that saves straight to disk",
    "longDescription": "flai downloads torrents straight to your disk. No account, no server in the middle, no size limit."
  }
}
